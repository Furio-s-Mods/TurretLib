# Path to C# project file
PROJECT_PATH=TurretLib.csproj

# Vintage Story target version (used if not detected in modinfo.json)
VS_VERSION=1.22.0

# Download URL pattern using $VS_VERSION substitution
VS_DOWNLOAD_URL_TEMPLATE=https://cdn.vintagestory.at/gamefiles/stable/vs_server_linux-x64_${VS_VERSION}.tar.gz

# MSBuild configuration mode
BUILD_CONFIGURATION=Release

# Location of repository changelog
CHANGELOG_PATH=CHANGELOG.md